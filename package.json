{
  "name": "pulseboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "test": "vitest run && npm run test --workspaces --if-present",
    "test:coverage": "vitest run --coverage",
    "audit:colors": "node scripts/color-usage-audit.js",
    "vercel-build": "vercel build",
    "lint": "eslint src client/src server tests --ext .js,.jsx --no-error-on-unmatched-pattern && npm run audit:colors",
    "format": "prettier --write ."
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^25.0.1",
    "supertest": "^7.2.2",
    "vercel": "^59.0.0",
    "vitest": "^4.1.10",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2"
  }
}
